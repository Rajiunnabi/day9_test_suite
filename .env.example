# Copy to .env and fill in real values. NEVER commit .env itself.

# ---------------------------------------------------------------- required
DATABASE_URL=postgresql+psycopg://postgres:yourpassword@localhost:5432/task_tracker

# Generate your own - anyone who knows this can forge a token for ANY user:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me-with-48-random-characters-from-the-command-above

# ---------------------------------------------------------------- optional
APP_NAME=Task Tracker API
ENVIRONMENT=local
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-separated. Your frontend's address(es). Never "*".
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
